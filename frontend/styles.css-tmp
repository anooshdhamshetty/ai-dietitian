.summary-widget-card .summary-value {
    font-size: 18px;
    font-weight: 900;
    color: var(--clr-text-main);
}

@media (max-width: 600px) {
    .summary-widgets {
        grid-template-columns: 1fr;
    }
}

/* Meal Swap Suggestion Card */
.swap-suggestion-card {
    border: 1px solid var(--clr-primary);
    background: rgba(139, 92, 246, 0.08) !important;
    grid-column: 1 / -1;
    animation: pulseBorder 3s infinite ease-in-out;
}

@keyframes pulseBorder {
    0% { border-color: var(--clr-primary); box-shadow: 0 0 5px rgba(139, 92, 246, 0.2); }
    50% { border-color: #ec4899; box-shadow: 0 0 15px rgba(236, 72, 153, 0.3); }
    100% { border-color: var(--clr-primary); box-shadow: 0 0 5px rgba(139, 92, 246, 0.2); }
}

.swap-content {
    margin-top: 0.5rem;
}
