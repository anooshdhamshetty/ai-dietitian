# 🥗 NutriVision Environment Configuration
# Copy this file to `.env` and fill in your own values

# ============================================
# Database Configuration
# ============================================

# OPTION 1: Development (SQLite - local file, no setup needed)
DATABASE_URL=sqlite:///./nutrivision.db

# OPTION 2: Production (PostgreSQL - Supabase)
# Uncomment line below and add your Supabase URL
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ============================================
# Supabase Configuration (NEW!)
# ============================================
# Get credentials from: https://supabase.com (free account)
# Navigate to: Settings → API Keys

# Your Supabase project URL (from API Keys)
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Public Key (safe to expose to frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...

# Your Supabase Service Role Key (keep secret! only in backend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# ============================================
# Authentication
# ============================================

# IMPORTANT: Change this to a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Groq LLM Configuration
# ============================================

# Get your API key from: https://console.groq.com/keys
# Sign up for free account and generate API key
GROQ_API_KEY=gsk_your_actual_groq_key_here

# ============================================
# Application Settings
# ============================================

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ============================================
# Deployment Platform Settings
# ============================================

# For Railway deployment
# RAILWAY_ENVIRONMENT=production

# For Heroku deployment (optional)
# HEROKU_APP_NAME=your-app-name

# For PythonAnywhere deployment
# PYTHONANYWHERE_DOMAIN=username.pythonanywhere.com

# For Azure deployment
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# ============================================
# Instructions
# ============================================
#
# LOCAL DEVELOPMENT:
#    cp .env.example .env
#    Edit .env with local values
#    python -m uvicorn main:app --reload
#
# WITH SUPABASE:
#    1. Create account at https://supabase.com
#    2. Create new project
#    3. Get API keys from Settings
#    4. Add SUPABASE_URL and SUPABASE_ANON_KEY
#    5. Run SQL schema from supabase_config.py
#    6. Test with: curl http://localhost:8000/api/supabase-status
#
# DOCKER (Optional):
#    docker-compose up -d
#    Automatically uses DATABASE_URL
#
# DEPLOYMENT (No Docker Needed):
#    Choose one: Railway, Heroku, PythonAnywhere, Render, Fly.io, Azure
#    See SUPABASE_NODCKER_DEPLOYMENT.md for guides
#
# TESTING:
#    - Test Supabase: curl http://localhost:8000/api/supabase-status
#    - Test Groq: curl http://localhost:8000/api/groq-status
#    - API Docs: http://localhost:8000/docs
#
